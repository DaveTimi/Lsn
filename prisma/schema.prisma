generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { PLATFORM_ADMIN SCHOOL_OWNER SCHOOL_ADMIN ACCOUNTANT TEACHER PARENT STUDENT }
enum Term { FIRST SECOND THIRD }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum AttendanceStatus { PRESENT ABSENT LATE EXCUSED }
model School { id String @id @default(cuid()) name String slug String @unique code String @unique logoUrl String? phone String? email String? address String? state String? country String @default("Nigeria") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt users User[] students Student[] parents Parent[] staff Staff[] classes Class[] subjects Subject[] sessions AcademicSession[] fees FeeCharge[] payments Payment[] exams Exam[] results Result[] announcements Announcement[] auditLogs AuditLog[] subscriptions Subscription[] timetable TimetableEntry[] documents Document[] idCards IDCard[] invoices Invoice[] notifications Notification[] messages Message[] financialTransactions FinancialTransaction[] }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String role Role schoolId String? school School? parentProfile Parent? staffProfile Staff? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt lastLoginAt DateTime? }
model AcademicSession { id String @id @default(cuid()) name String schoolId String school School startDate DateTime endDate DateTime isCurrent Boolean @default(false) terms TermRecord[] @@unique([schoolId,name]) }
model TermRecord { id String @id @default(cuid()) name Term sessionId String session AcademicSession startDate DateTime endDate DateTime @@unique([sessionId,name]) }
model Student { id String @id @default(cuid()) studentId String schoolId String school School firstName String lastName String otherName String? gender String? dob DateTime? photoUrl String? email String? phone String? address String? status String @default("active") classId String? class Class? parentLinks ParentStudent[] enrollments Enrollment[] attendance Attendance[] results Result[] fees FeeCharge[] payments Payment[] invoices Invoice[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([schoolId,studentId]) }
model Parent { id String @id @default(cuid()) parentId String schoolId String school School firstName String lastName String email String? phone String? address String? links ParentStudent[] userId String? user User? @relation(fields:[userId],references:[id]) }
model ParentStudent { parentId String studentId String relationship String parent Parent @relation(fields:[parentId],references:[id],onDelete:Cascade) student Student @relation(fields:[studentId],references:[id],onDelete:Cascade) @@id([parentId,studentId]) }
model Staff { id String @id @default(cuid()) staffId String schoolId String school School firstName String lastName String email String? phone String? department String? position String? userId String? user User? @relation(fields:[userId],references:[id]) createdAt DateTime @default(now()) }
model Class { id String @id @default(cuid()) name String level String? schoolId String school School students Student[] teacherAssignments TeacherAssignment[] timetable TimetableEntry[] exams Exam[] }
model Subject { id String @id @default(cuid()) name String code String? schoolId String school School teacherAssignments TeacherAssignment[] exams Exam[] timetable TimetableEntry[] @@unique([schoolId,name]) }
model TeacherAssignment { id String @id @default(cuid()) staffId String subjectId String classId String staff Staff subject Subject class Class @@unique([staffId,subjectId,classId]) }
model Enrollment { id String @id @default(cuid()) studentId String sessionId String classId String student Student session AcademicSession class Class status String @default("active") @@unique([studentId,sessionId]) }
model Attendance { id String @id @default(cuid()) studentId String date DateTime status AttendanceStatus note String? student Student @@unique([studentId,date]) }
model FeeCharge { id String @id @default(cuid()) schoolId String studentId String sessionId String? title String amount Decimal @db.Decimal(14,2) dueDate DateTime? student Student school School session AcademicSession? payments Payment[] createdAt DateTime @default(now()) }
model Payment { id String @id @default(cuid()) schoolId String studentId String? feeChargeId String? reference String @unique amount Decimal @db.Decimal(14,2) status PaymentStatus method String? paidAt DateTime? student Student? school School feeCharge FeeCharge? createdAt DateTime @default(now()) }
model Exam { id String @id @default(cuid()) schoolId String classId String subjectId String title String durationMinutes Int totalMarks Int startAt DateTime? published Boolean @default(false) school School class Class subject Subject questions Question[] results Result[] createdAt DateTime @default(now()) }
model Question { id String @id @default(cuid()) examId String text String options Json answer String marks Int @default(1) }
model Result { id String @id @default(cuid()) schoolId String studentId String examId String score Float grade String? remark String? school School student Student exam Exam @@unique([studentId,examId]) }
model Announcement { id String @id @default(cuid()) schoolId String title String body String audience String @default("all") published Boolean @default(true) createdAt DateTime @default(now()) school School }
model Subscription { id String @id @default(cuid()) schoolId String plan String status String startAt DateTime endAt DateTime? provider String? providerRef String? school School createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) schoolId String? userId String? action String entity String entityId String? metadata Json? createdAt DateTime @default(now()) school School? }

model TimetableEntry { id String @id @default(cuid()) schoolId String classId String subjectId String teacherId String? day Int startTime String endTime String room String? school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) class Class @relation(fields:[classId],references:[id],onDelete:Cascade) subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade) }
model Document { id String @id @default(cuid()) schoolId String title String category String url String createdAt DateTime @default(now()) school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) }
model IDCard { id String @id @default(cuid()) schoolId String ownerType String ownerId String publicId String @unique qrToken String @unique issuedAt DateTime @default(now()) active Boolean @default(true) school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) }
model Invoice { id String @id @default(cuid()) schoolId String studentId String number String @unique amount Decimal @db.Decimal(14,2) status String @default("open") issuedAt DateTime @default(now()) dueDate DateTime? school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) student Student @relation(fields:[studentId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(cuid()) schoolId String userId String? title String body String readAt DateTime? createdAt DateTime @default(now()) school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) }
model Message { id String @id @default(cuid()) schoolId String senderId String recipientId String body String createdAt DateTime @default(now()) school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) }
model FinancialTransaction { id String @id @default(cuid()) schoolId String type String reference String? amount Decimal @db.Decimal(14,2) description String? createdAt DateTime @default(now()) school School @relation(fields:[schoolId],references:[id],onDelete:Cascade) }
